      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "plt.scatter(X[y == 1, 0], X[y == 1, 1], color='blue', label='Class 1')\n",
        "plt.scatter(X[y == 2, 0], X[y == 2, 1], color='red', label='Class 2')\n",
